{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>wittdennis/renovate-config"],
  "baseBranchPatterns": ["$default", "/^release\\/.*/"],
  "packageRules": [
    {
      "matchFileNames": ["*/Chart.yaml", "*/values.yaml"],
      "semanticCommitType": "fix"
    },
    {
      "matchDepNames": ["norwoodj/helm-docs"],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    }
  ]
}
